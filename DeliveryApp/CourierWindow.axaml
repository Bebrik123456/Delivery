<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DeliveryApp.CourierWindow"
        Title="CourierWindow">
<Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка с информацией -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="20">
            <Button x:Name="StartShiftButton" Content="Начать смену" />
            <Button x:Name="EndShiftButton" Content="Завершить смену"  IsEnabled="False"/>
        </StackPanel>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Margin="0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Список заказов -->
            <StackPanel Grid.Column="0" Margin="0 0 10 0">
                <TextBlock FontSize="16" Text="Мои заказы" Margin="0 0 0 10"/>
                <ListBox x:Name="OrdersListBox" Height="400">
                    <!-- Простой список без шаблонов -->
                </ListBox>
                <Button x:Name="RefreshButton" Content="Обновить" Margin="0 10 0 0"/>
            </StackPanel>

            <!-- Детали заказа -->
            <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock x:Name="OrderHeaderText" FontSize="16" Text="Выберите заказ"/>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Адрес:"/>
                    <TextBlock x:Name="OrderAddressText" Grid.Row="0" Grid.Column="1" Text="Не выбран"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Клиент:"/>
                    <TextBlock x:Name="OrderClientText" Grid.Row="1" Grid.Column="1" Text="Не выбран"/>

                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="AcceptOrderButton" Content="Принять заказ"/>
                        <Button x:Name="CompleteOrderButton" Content="Завершить" IsEnabled="False"/>
                    </StackPanel>
                </Grid>

                <!-- Карта-заглушка -->
                <Border BorderBrush="Gray" BorderThickness="1" Height="300">
                    <Image x:Name="MapImage" Stretch="UniformToFill"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Статистика -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
            <TextBlock x:Name="StatsTodayText" Text="За сегодня: 0"/>
            <TextBlock x:Name="StatsActiveText" Text="Активные: 0"/>
        </StackPanel>
    </Grid>
</Window>
