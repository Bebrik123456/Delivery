<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="DeliveryApp.AdministratorMainWindow"
        Title="Служба Доставки"
        FontFamily="Arial"
        Background="#f0f0f0">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Служба Доставки" FontSize="24" FontWeight="Bold" Margin="0 0 0 20" HorizontalAlignment="Center" Foreground="#007BFF"/>

        <!-- Active Shift Info -->
        <Border Grid.Row="1" Background="White" BorderBrush="#007BFF" BorderThickness="2" CornerRadius="10" Padding="10" Margin="0 0 0 20">
            <StackPanel>
                <TextBlock x:Name="ShiftInfo" FontSize="18" FontWeight="Bold" Margin="0 5" HorizontalAlignment="Center" Foreground="#007BFF"/>
                <TextBlock x:Name="StatusMessage" FontSize="16" Margin="0 5" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Employees Section -->
            <Border Grid.Column="0" Background="White" BorderBrush="#007BFF" BorderThickness="2" CornerRadius="10" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Сотрудники" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 5" HorizontalAlignment="Center" Foreground="#007BFF"/>
                    <TextBlock Text="Управление сотрудниками и ролями" FontSize="12" Margin="0 0 0 10" HorizontalAlignment="Center"/>
                    <Button Content="Открыть" HorizontalAlignment="Center" Padding="10 5" Background="#007BFF" Foreground="White" CornerRadius="5"/>
                </StackPanel>
            </Border>

            <!-- Shifts Section -->
            <Border Grid.Column="1" Background="White" BorderBrush="#007BFF" BorderThickness="2" CornerRadius="10" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Смены" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 5" HorizontalAlignment="Center" Foreground="#007BFF"/>
                    <TextBlock Text="Управление и планирование смен" FontSize="12" Margin="0 0 0 10" HorizontalAlignment="Center"/>
                    <Button Content="Открыть" HorizontalAlignment="Center" Padding="10 5" Background="#007BFF" Foreground="White" CornerRadius="5"/>
                </StackPanel>
            </Border>

            <!-- Orders Section -->
            <Border Grid.Column="2" Background="White" BorderBrush="#007BFF" BorderThickness="2" CornerRadius="10" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Заказы" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 5" HorizontalAlignment="Center" Foreground="#007BFF"/>
                    <TextBlock Text="Просмотр и управление заказами" FontSize="12" Margin="0 0 0 10" HorizontalAlignment="Center"/>
                    <Button Content="Открыть" HorizontalAlignment="Center" Padding="10 5" Background="#007BFF" Foreground="White" CornerRadius="5"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- New Orders Section -->
        <Border Grid.Row="3" Background="White" BorderBrush="#007BFF" BorderThickness="2" CornerRadius="10" Margin="5" Padding="10">
            <StackPanel>
                <TextBlock Text="Новые заказы" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 5" HorizontalAlignment="Center" Foreground="#007BFF"/>

                <!-- In Progress -->
                <StackPanel Margin="0 10 0 5" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="В процессе:" FontSize="14"/>
                    <TextBlock Name="NumBlock" FontSize="14" FontWeight="Bold" Margin="5 0 0 0"/>
                </StackPanel>

                <!-- Completed -->
                <StackPanel Margin="0 5 0 0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Выполненные за смену:" FontSize="14"/>
                    <TextBlock Text="0" FontSize="14" FontWeight="Bold" Margin="5 0 0 0"/>
                </StackPanel>

                <!-- Total -->
                <Border Margin="0 10 0 0" BorderBrush="LightGray" BorderThickness="0 1 0 0" Padding="0 5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Всего:" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Name="Num2" FontSize="24" FontWeight="Bold" Margin="10 0 0 0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
