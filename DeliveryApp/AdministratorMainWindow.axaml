<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="DeliveryApp.AdministratorMainWindow"
        Title="Служба Доставки"
        FontFamily="Arial">
        
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Служба Доставки" FontSize="24" FontWeight="Bold" Margin="0 0 0 20"/>
        
        <!-- Active Shift Info -->
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="0 0 0 1" Padding="0 0 0 10" Margin="0 0 0 20">
            <StackPanel Margin="10">
                <TextBlock x:Name="ShiftInfo" FontSize="18" FontWeight="Bold" Margin="0 5"/>
                <TextBlock x:Name="StatusMessage" FontSize="16" Margin="0 5"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Employees Section -->
            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Сотрудники" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 5"/>
                    <TextBlock Text="Управление сотрудниками и ролями" FontSize="12" Margin="0 0 0 10"/>
                    <Button Content="Открыть" HorizontalAlignment="Left" Padding="10 5" Click="Button_OnClick"/>
                </StackPanel>
            </Border>
            
            <!-- Shifts Section -->
            <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Смены" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 5"/>
                    <TextBlock Text="Управление и планирование смен" FontSize="12" Margin="0 0 0 10"/>
                    <Button Content="Открыть" HorizontalAlignment="Left" Padding="10 5"/>
                </StackPanel>
            </Border>
            
            <!-- Orders Section -->
            <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Заказы" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 5"/>
                    <TextBlock Text="Просмотр и управление заказами" FontSize="12" Margin="0 0 0 10"/>
                    <Button Content="Открыть" HorizontalAlignment="Left" Padding="10 5"/>
                </StackPanel>
            </Border>
            
            <!-- New Orders Section -->
            
        </Grid>
        <Border Grid.Row="4" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
            <StackPanel>
                <TextBlock Text="Новые заказы" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 5"/>
                    
                <!-- In Progress -->
                <StackPanel Margin="0 10 0 5" Orientation="Horizontal">
                    <TextBlock Text="В процессе:" FontSize="14"/>
                    <TextBlock Name="NumBlock"  FontSize="14" FontWeight="Bold" Margin="5 0 0 0"/>
                </StackPanel>
                    
                <!-- Completed -->
                <StackPanel Margin="0 5 0 0" Orientation="Horizontal">
                    <TextBlock Text="Выполненные за смену:" FontSize="14"/>
                    <TextBlock Text="0" FontSize="14" FontWeight="Bold" Margin="5 0 0 0"/>
                </StackPanel>
                    
                <!-- Total -->
                <Border Margin="0 10 0 0" BorderBrush="LightGray" BorderThickness="0 1 0 0" Padding="0 5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Всего:" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Name ="Num2" FontSize="24" FontWeight="Bold" Margin="10 0 0 0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>