 <Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="DeliveryApp.LoginWindow"
        Title="Login - DeliveryApp"
        MinWidth="800"
        MinHeight="600">
    <Grid>
    <Image Source="Image/Logo.jpg" 
           HorizontalAlignment="Left" 
           VerticalAlignment="Top"
           MinWidth="100" 
           MinHeight="100"
           MaxWidth="150" 
           MaxHeight="100"
           Margin="5 5 0 0" />
    
    <StackPanel Margin="20" HorizontalAlignment="Center" Spacing="20" VerticalAlignment="Center">
        
        <TextBlock Text="Авторизаия" FontSize="20" HorizontalAlignment="Center"/>
       
        <TextBox Name="UsernameTextBox" Width="300" Watermark="Введите логин"/>
        
     
        <TextBox Name="PasswordTextBox" Width="300" Watermark="Введите пароль"/>
        
        <Button Name="LoginButton" Content="Войти"
                MinWidth="100"
                Click="OnLoginButtonClick"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Center"
                Background="#007BFF" 
                Foreground="Azure"/>
    </StackPanel>
    </Grid>
</Window>